# Database configuration (sqlite for development, postgres for production)
DB_TYPE=sqlite
DATABASE_URL=postgres://postgres:postgres@postgres:5432/privateai

# Vector Database (sqlite for development, qdrant for production)
VECTOR_DB_TYPE=sqlite
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=privateai_chunks

# Object Storage (local for development, minio for production)
STORAGE_TYPE=local
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=privateai-documents

# Private LLM Provider (ollama for development, vllm for production)
LLM_PROVIDER=ollama
LLM_BASE_URL=http://ollama:11434
LLM_MODEL=qwen2.5:3b
EMBED_MODEL=nomic-embed-text

# Ollama environment (used during dev/local setups)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen2.5:3b
OLLAMA_EMBED_MODEL=nomic-embed-text

# API Security and Session Control
API_KEY=your_highly_secure_secret_token_here
JWT_SECRET=your_jwt_signing_key_here
